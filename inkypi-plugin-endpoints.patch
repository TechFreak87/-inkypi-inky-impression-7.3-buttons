+@plugin_bp.route('/shutdown_screen', methods=['POST'])
+def shutdown_screen():
+    device_config = current_app.config['DEVICE_CONFIG']
+    display_manager = current_app.config['DISPLAY_MANAGER']
+
+    try:
+        from PIL import Image, ImageDraw, ImageFont
+        import time
+
+        width, height = device_config.get_resolution()
+
+        def load_font(size):
+            candidates = [
+                "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
+                "/usr/share/fonts/truetype/liberation2/LiberationSans-Bold.ttf",
+            ]
+
+            for font_path in candidates:
+                if os.path.exists(font_path):
+                    return ImageFont.truetype(font_path, size)
+
+            return ImageFont.load_default()
+
+        # 1) Short shutdown status screen
+        image = Image.new("RGB", (width, height), "white")
+        draw = ImageDraw.Draw(image)
+
+        title_font = load_font(58)
+        subtitle_font = load_font(23)
+
+        title = "Shutting down..."
+        subtitle = "Raspberry Pi wird ausgeschaltet"
+
+        title_box = draw.textbbox((0, 0), title, font=title_font)
+        title_width = title_box[2] - title_box[0]
+        title_height = title_box[3] - title_box[1]
+
+        subtitle_box = draw.textbbox((0, 0), subtitle, font=subtitle_font)
+        subtitle_width = subtitle_box[2] - subtitle_box[0]
+
+        center_y = height // 2
+
+        draw.text(
+            ((width - title_width) // 2, center_y - title_height),
+            title,
+            fill="black",
+            font=title_font,
+        )
+
+        draw.text(
+            ((width - subtitle_width) // 2, center_y + 28),
+            subtitle,
+            fill="black",
+            font=subtitle_font,
+        )
+
+        display_manager.display_image(image)
+
+        # Brief pause before replacing it with the permanent standby image.
+        time.sleep(1)
+
+        # 2) Permanent standby image
+        standby_path = "/usr/local/inkypi/assets/inkypi-shutdown-screen-800x480.png"
+
+        if not os.path.exists(standby_path):
+            return jsonify({
+                "success": False,
+                "error": f"Standby image not found: {standby_path}"
+            }), 500
+
+        with Image.open(standby_path) as standby:
+            standby_image = standby.convert("RGB")
+
+        if standby_image.size != (width, height):
+            standby_image = standby_image.resize((width, height))
+
+        display_manager.display_image(standby_image)
+
+        return jsonify({
+            "success": True,
+            "message": "Shutdown and standby screens displayed"
+        }), 200
+
+    except Exception as e:
+        logger.exception(f"Error displaying shutdown screen: {str(e)}")
+
+        return jsonify({
+            "success": False,
+            "error": str(e)
+        }), 500
+
